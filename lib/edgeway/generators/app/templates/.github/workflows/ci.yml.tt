name: CI

on:
  push:
    branches:
      - main

  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    # The first run builds Spinel from source; later runs use mise-action's cache.
    timeout-minutes: 15

    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0
        with:
          persist-credentials: false
      # The Ruby in .ruby-version.
      - name: Set up Ruby
        uses: ruby/setup-ruby@651ff0d62c5c79bed6d53ec518387aae20e72c1a # v1.329.0
        with:
          bundler-cache: true
      # Everything in mise.toml: the WASI SDK (bin/build needs it), Spinel,
      # Node.js, and <%= PackageManager.name %>.
      - name: Install the tools
        uses: jdx/mise-action@9b200bcecbfd6303e69a4a261b2e09e3757440a7 # v5.2.0
      # `edgeway test` runs the tests on the local D1 of wrangler.
      - name: Install wrangler
        run: <%= PackageManager.install %>
      - name: Run the tests
        run: bin/test
      - name: Build
        run: bin/build --release
