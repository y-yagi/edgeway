name = "<%= @name %>"
main = "src/worker.js"
compatibility_date = "2026-10-01"

# CORS, for a frontend on another origin (see the README's "CORS"): the
# origins allowed, comma-separated and compared exactly (no trailing slash).
# Unset, CORS is off. CORS_HEADERS defaults to "Authorization, Content-Type",
# CORS_MAX_AGE to 600. Variables are not inherited by an [env.*]: write them
# again under [env.<name>.vars]. The app sees only the framework's settings
# (JWT_*) and variables named APP_*, read with Edgeway.config("APP_NAME").
# [vars]
# CORS_ORIGINS = "http://localhost:3000, https://app.example"

# Files in public/ are served as is, without starting the app, so they are
# always public: `before_action :authenticate!` never sees them. A file takes
# its path from the app for every method (other than GET/HEAD it is 405):
# public/index.html answers `/`, public/todos.html `/todos`. Anything else goes
# to the app. For an SPA, see Edgeway's README, "Static assets".
[assets]
directory = "./public"

# Simulated locally by `wrangler dev`. Create tables with
# `<%= PackageManager.exec %> wrangler d1 migrations apply <%= @name %>-db --local`.
# database_id is a placeholder (all zeros): that is enough for --local and
# `wrangler dev`, which ignore it. Before a deploy, create the database
# (`<%= PackageManager.exec %> wrangler d1 create <%= @name %>-db`) and put the id it prints here.
[[d1_databases]]
binding = "DB"
database_name = "<%= @name %>-db"
database_id = "00000000-0000-0000-0000-000000000000"
migrations_dir = "db/migrations"

# A second database (config/database.yml's databases:) is another binding,
# with an id of its own: the same id is the same local database:
# [[d1_databases]]
# binding = "ANALYTICS"
# database_name = "<%= @name %>-analytics"
# database_id = "00000000-0000-0000-0000-000000000001"
# migrations_dir = "db/analytics/migrations"
