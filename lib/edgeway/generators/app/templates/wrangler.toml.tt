name = "<%= @name %>"
main = "src/worker.js"
compatibility_date = "2026-10-01"

# CORS, for a frontend on another origin (see the README's "CORS"): the
# origins allowed, comma-separated and compared exactly (no trailing slash).
# Unset, CORS is off. CORS_HEADERS defaults to "Authorization, Content-Type",
# CORS_MAX_AGE to 600. Variables are not inherited by an [env.*]: write them
# again under [env.<name>.vars]. The app sees only the framework's settings
# (JWT_*) and variables named APP_*, read with Edgeway.config("APP_NAME").
# [vars]
# CORS_ORIGINS = "http://localhost:3000, https://app.example"

# Simulated locally by `wrangler dev`. Create tables with
# `<%= PackageManager.exec %> wrangler d1 migrations apply <%= @name %>-db --local`.
[[d1_databases]]
binding = "DB"
database_name = "<%= @name %>-db"
database_id = "00000000-0000-0000-0000-000000000000"
migrations_dir = "db/migrations"
