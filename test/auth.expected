-- the error classes
Edgeway::InvalidToken < Edgeway::Unauthorized < Edgeway::Error < StandardError
-- requests
/me [] -> 401 {"error":"authentication required"}  (Bearer)
/me [Bearer good] -> 200 {"sub":"u1","authenticated":true}
/me [bearer good] -> 200 {"sub":"u1","authenticated":true}
/me [Bearer   good  ] -> 200 {"sub":"u1","authenticated":true}
/me [Bearer] -> 401 {"error":"authentication required"}  (Bearer)
/me [Bearer ] -> 401 {"error":"authentication required"}  (Bearer)
/me [Basic Zm9vOmJhcg==] -> 401 {"error":"authentication required"}  (Bearer)
/me [Bearer old] -> 401 {"error":"invalid token"}  (Bearer error="invalid_token")
/me [Bearer nope] -> 401 {"error":"invalid token"}  (Bearer error="invalid_token")
/open [] -> 200 {"authenticated":false,"claims":{}}
/open [Bearer good] -> 200 {"authenticated":false,"claims":{}}
/soft [] -> 403 {"denied":"authentication required"}
/soft [Bearer nope] -> 403 {"denied":"signature is not valid"}
/soft [Bearer good] -> 200 {"ok":true}
-- the verifier can't check
/me [Bearer down] -> 500 {"error":"internal error"}
-- the log has the reasons, never the token
/me [] -> 401 {"error":"authentication required"}  (Bearer)
/me [Bearer old] -> 401 {"error":"invalid token"}  (Bearer error="invalid_token")
/me [Bearer secret-token-value] -> 401 {"error":"invalid token"}  (Bearer error="invalid_token")
/me [Bearer down] -> 500 {"error":"internal error"}
