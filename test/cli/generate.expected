class TodosController < ApplicationController
  def index = render json: Todo.order(:id).limit(50)

  def show = render json: Todo.find(params[:id])

  def create
    todo = Todo.create!(todo_params)
    render json: todo, status: :created
  end

  def update
    todo = Todo.find(params[:id])
    todo.update!(todo_params)
    render json: todo
  end

  def destroy
    Todo.find(params[:id]).destroy
    head :no_content
  end

  private

  def todo_params = params.require(:todo).permit(:title, :done, :priority, :score, :due)
end
-- test/controllers/todos_test.rb
require "edgeway/test"
require "test_helper"

class TodosTest < Edgeway::IntegrationTest
  def test_index
    todo = Todo.create!(title: "MyString", done: true, priority: 1, score: 1.5, due: "2026-01-01T00:00:00Z")
    get "/todos"
    assert_response 200
    assert_equal 1, json.size
    assert_equal todo.id, json[0]["id"]
  end

  def test_show
    todo = Todo.create!(title: "MyString", done: true, priority: 1, score: 1.5, due: "2026-01-01T00:00:00Z")
    get "/todos/#{todo.id}"
    assert_response 200
    assert_equal todo.id, json["id"]
  end

  def test_show_not_found
    get "/todos/0"
    assert_response 404
  end

  def test_create
    post "/todos", json: { "todo" => { "title" => "MyString", "done" => true, "priority" => 1, "score" => 1.5, "due" => "2026-01-01T00:00:00Z" } }
    assert_response 201
    assert_equal 1, Todo.count
    assert_equal "MyString", json["title"]
    assert_equal true, json["done"]
    assert_equal 1, json["priority"]
    assert_equal 1.5, json["score"]
    assert_equal "2026-01-01T00:00:00Z", json["due"]
  end

  def test_update
    todo = Todo.create!(title: "MyString", done: true, priority: 1, score: 1.5, due: "2026-01-01T00:00:00Z")
    patch "/todos/#{todo.id}", json: { "todo" => { "title" => "Updated", "done" => false, "priority" => 2, "score" => 2.5, "due" => "2026-02-01T00:00:00Z" } }
    assert_response 200
    assert_equal "Updated", json["title"]
    assert_equal false, json["done"]
    assert_equal 2, json["priority"]
    assert_equal 2.5, json["score"]
    assert_equal "2026-02-01T00:00:00Z", json["due"]
  end

  def test_destroy
    todo = Todo.create!(title: "MyString", done: true, priority: 1, score: 1.5, due: "2026-01-01T00:00:00Z")
    delete "/todos/#{todo.id}"
    assert_response 204
    assert_equal 0, Todo.count
  end
end
