-- app/models/todo.rb
class Todo < ApplicationModel
  attribute :title, :string
  attribute :done, :boolean, default: false
  attribute :priority, :integer
  attribute :due, :datetime
  timestamps
end
-- db/migrations/0001_create_todos.sql
CREATE TABLE todos (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  title TEXT,
  done INTEGER NOT NULL DEFAULT 0,
  priority INTEGER,
  due TEXT,
  created_at TEXT,
  updated_at TEXT
);
-- test/models/todo_test.rb
require "edgeway/test"
require "test_helper"

class TodoTest < Edgeway::IntegrationTest
  def test_starts_empty
    assert_equal 0, Todo.count
  end
end
