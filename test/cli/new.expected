require "edgeway/test"
require "edgeway/test"
require "test_helper"
class HealthTest < Edgeway::IntegrationTest
gem "spinel_test-unit", "~> 0.1", group: :test
bin/setup executable: true
bin/build executable: true
bin/deploy executable: true
bin/test executable: true
package.json: nil
mise.toml: node = "lts"; pnpm = "latest"; 
bin/build --release
pnpm exec wrangler d1 migrations apply my_app-db --remote
pnpm exec wrangler deploy "$@"
mentions npm/npx: []
        run: pnpm install
        run: bin/test
        run: bin/build --release
.ruby-version: true
Next: cd APP && bin/setup && bin/test && bin/build
