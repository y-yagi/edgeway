-- the default limiter allows everything
GET /open -> 200 {"ok":"open"}
POST /posts -> 200 {"ok":"create"}
-- only and except
GET /posts -> 200 {"ok":"index"}
POST /posts -> 200 {"ok":"create"}
  checked WRITE_LIMITER PostsController:ip:203.0.113.7
GET /reports/1 -> 200 {"ok":"show"}
  checked BURST_LIMITER reports:ip:203.0.113.7
-- the key is per controller, and by: picks the rest
GET /reports -> 200 {"ok":"index"}
  checked READ_LIMITER ReportsController:tenant-t1
  checked BURST_LIMITER reports:ip:203.0.113.7
GET /archives -> 200 {"ok":"archive"}
  checked READ_LIMITER ArchivesController:tenant-t1
  checked BURST_LIMITER reports:ip:203.0.113.7
-- the default key of an authenticated request
GET /account -> 200 {"ok":"show"}
  checked ACCOUNT_LIMITER AccountsController:user:u1
GET /account -> 401 {"error":"authentication required"}
-- an empty client address, a by: answering an Integer and nil
POST /posts -> 200 {"ok":"create"}
  checked WRITE_LIMITER PostsController:ip:
GET /account_key -> 200 {"ok":"index"}
  checked ACCOUNT_KEY_LIMITER AccountKeyController:42
  checked NOTHING_LIMITER AccountKeyController:
-- order: a before_action that renders comes first
GET /halted -> 403 {"refused":true}
-- order: a parent's rate_limit runs before the child's authenticate!
GET /child -> 401 {"error":"authentication required"}
GET /child -> 200 {"ok":"child"}
